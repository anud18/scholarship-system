<!DOCTYPE html>
<html lang="zh-Hant"><head><meta charset="utf-8"><title>{% block title %}{% endblock %}</title>
<style>
  /* Noto CJK first: the reports are Traditional Chinese and a Latin-only
     font silently renders every CJK glyph as nothing. */
  body { font-family: 'Noto Sans CJK TC', 'Noto Sans CJK SC', sans-serif;
         font-size: 10pt; line-height: 1.5; color: #222; }
  h1 { font-size: 18pt; color: #1f3a5f; border-bottom: 3px solid #1f3a5f; padding-bottom: 6px; margin-top: 0; }
  h2 { font-size: 13pt; color: #1f3a5f; border-left: 4px solid #1f3a5f; padding-left: 8px; margin-top: 22px; }
  h3 { font-size: 11pt; margin: 14px 0 4px; }
  table { width: 100%; border-collapse: collapse; margin: 8px 0 12px; }
  th, td { border: 1px solid #c5ccd6; padding: 4px 6px; text-align: left; vertical-align: top; }
  th { background: #1f3a5f; color: #fff; font-weight: normal; }
  tr:nth-child(even) td { background: #f5f7fa; }
  td.num, th.num { text-align: right; white-space: nowrap; }
  code, .mono { font-family: 'Noto Sans Mono CJK TC', monospace; font-size: 8.5pt; word-break: break-all; }
  .meta td:first-child { width: 28%; font-weight: bold; background: #eef1f5; }
  .note { background: #fff8e6; border-left: 4px solid #e0a100; padding: 8px 12px; margin: 10px 0; }
  .finding { border-left: 4px solid #9aa5b1; background: #f7f8fa; padding: 6px 10px; margin: 8px 0;
             page-break-inside: avoid; }
  .finding p { margin: 3px 0; }
  /* ZAP alerts can run longer than a page: let them split, keep the heading with its body. */
  .finding.long { page-break-inside: auto; }
  h2, h3 { page-break-after: avoid; }
  tr { page-break-inside: avoid; }
  .sev { display: inline-block; padding: 1px 6px; border-radius: 3px; color: #fff; font-size: 8.5pt; }
  .sev-Critical { background: #7b0000; } .sev-High { background: #c0392b; }
  .sev-Medium { background: #d35400; } .sev-Low { background: #2471a3; }
  .sev-Info, .sev-Informational { background: #7f8c8d; }
  .finding.sev-border-Critical { border-left-color: #7b0000; } .finding.sev-border-High { border-left-color: #c0392b; }
  .finding.sev-border-Medium { border-left-color: #d35400; } .finding.sev-border-Low { border-left-color: #2471a3; }
  .muted { color: #6b7785; }
  .pre { white-space: pre-wrap; }
  .foot { margin-top: 28px; border-top: 1px solid #c5ccd6; padding-top: 8px; color: #6b7785; font-size: 8.5pt; text-align: center; }
</style></head><body>
{% block body %}{% endblock %}
<div class="foot">{{ meta.repo }} · commit {{ meta.commit[:12] }} · 產出時間 {{ meta.generated }}</div>
</body></html>
